# Firebase (fill with your Firebase web app configuration)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ImgBB (server-side only)
IMGBB_API_KEY=

# Firebase Admin (server-side only; use one of these credential mechanisms)
# FIREBASE_ADMIN_PROJECT_ID=your-firebase-project-id
# GOOGLE_APPLICATION_CREDENTIALS=C:\secure\firebase-service-account.json
# FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON={...}

# Admin authorization is set as a Firebase custom claim, not an environment
# variable. Grant it from a trusted server or Firebase Admin SDK:
# setCustomUserClaims(uid, { admin: true })

# Site
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_NAME=AP Pulse
NEXT_PUBLIC_SITE_TAGLINE=Andhra in every Pulse
